<Window x:Class="TodoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo List" Width="850" Height="570" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#111111" Foreground="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#292929" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="Padding" Value="7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#555555" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Мои задачи" FontSize="24" FontWeight="SemiBold"
                       DockPanel.Dock="Left" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Загрузить JSON" Click="LoadClick" />
                <Button Content="Сохранить JSON" Click="SaveClick" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="Список задач" DockPanel.Dock="Top" Margin="0,0,0,8" />
                <ListBox x:Name="TaskList" Background="#242424" Foreground="White"
                         BorderBrush="#555555" DisplayMemberPath="Title"
                         SelectionChanged="TaskSelected" />
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Название" Margin="0,0,0,5" />
                    <TextBox x:Name="TitleInput" MaxLength="120" Height="34" Margin="0,0,0,12" />

                    <TextBlock Text="Описание" Margin="0,0,0,5" />
                    <TextBox x:Name="DescriptionInput" MaxLength="2000" Height="85"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                    <TextBlock x:Name="CreatedAtText" Margin="0,0,0,12"
                               Foreground="#BBBBBB" />

                    <TextBlock Text="Срок выполнения" Margin="0,0,0,5" />
                    <DatePicker x:Name="DueDateInput" Height="32" Margin="0,0,0,12" />

                    <TextBlock Text="Приоритет" Margin="0,0,0,5" />
                    <ComboBox x:Name="PriorityInput" Height="32" Margin="0,0,0,12">
                        <ComboBoxItem Content="Низкий" />
                        <ComboBoxItem Content="Средний" />
                        <ComboBoxItem Content="Высокий" />
                    </ComboBox>

                    <TextBlock Text="Статус" Margin="0,0,0,5" />
                    <ComboBox x:Name="StatusInput" Height="32" Margin="0,0,0,18">
                        <ComboBoxItem Content="Не начата" />
                        <ComboBoxItem Content="В процессе" />
                        <ComboBoxItem Content="Выполнена" />
                    </ComboBox>

                    <WrapPanel>
                        <Button Content="Новая" Click="NewClick" />
                        <Button Content="Добавить" Click="AddClick" />
                        <Button Content="Изменить" Click="EditClick" />
                        <Button Content="Удалить" Click="DeleteClick" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="2" Foreground="#BBBBBB"
                   Margin="0,12,0,0" />
    </Grid>
</Window>
